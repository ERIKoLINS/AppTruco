<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/nome_jogador1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="80dp"
        android:text="Jogador 1:"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutJogador1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nome do jogador 1"
        app:layout_constraintEnd_toEndOf="@+id/salvar"
        app:layout_constraintStart_toStartOf="@+id/nome_jogador1"
        app:layout_constraintTop_toBottomOf="@+id/nome_jogador1">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputJogador1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/nome_jogador2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Jogador 2:"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@+id/nome_jogador1"
        app:layout_constraintTop_toBottomOf="@+id/layoutJogador1" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutJogador2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nome do jogador 2"
        app:layout_constraintEnd_toEndOf="@+id/layoutJogador1"
        app:layout_constraintStart_toStartOf="@+id/nome_jogador2"
        app:layout_constraintTop_toBottomOf="@+id/nome_jogador2">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputJogador2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/salvar"
        style="@style/BotaoPontuacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:text="Salvar nomes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/nome_jogador2"
        app:layout_constraintTop_toBottomOf="@id/layoutJogador2" />

    <Button
        android:id="@+id/voltar"
        style="@style/BotaoPontuacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Voltar"
        app:layout_constraintTop_toBottomOf="@id/salvar"
        app:layout_constraintEnd_toEndOf="@+id/salvar"
        app:layout_constraintStart_toStartOf="@+id/salvar" />

</androidx.constraintlayout.widget.ConstraintLayout>
