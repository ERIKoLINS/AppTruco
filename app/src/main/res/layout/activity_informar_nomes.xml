<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Nome do jogador 1 -->
    <TextView
        android:id="@+id/nome_jogador1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jogador 1:"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="80dp"/>

    <!-- Campo para digitar o jogador 1 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutJogador1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nome do jogador 1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/nome_jogador1"
        app:layout_constraintTop_toBottomOf="@+id/nome_jogador1">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputJogador1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nome do jogador 2 -->
    <TextView
        android:id="@+id/nome_jogador2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Jogador 2:"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutJogador1" />

    <!-- Campo para digitar o jogador 2 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutJogador2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nome do jogador 2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/nome_jogador2"
        app:layout_constraintTop_toBottomOf="@+id/nome_jogador2">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputJogador2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botão salvar -->
    <Button
        android:id="@+id/salvar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Salvar nomes"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/layoutJogador2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Botão voltar -->
    <Button
        android:id="@+id/voltar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Voltar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
